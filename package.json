{
  "name": "controle-financeiro-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do Controle Financeiro - desafio NestJS e React",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "build": "npm run db:generate && nest build",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/api.test.cjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run build && node prisma/seed.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.9",
    "@prisma/adapter-pg": "7",
    "@prisma/client": "7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "prisma": "7",
    "typescript": "~5.9.3"
  }
}
